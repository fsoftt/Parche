<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Parche.App.Converters"
             x:Class="Parche.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:InverseBoolConverter x:Key="Not" />
      <conv:HasValueConverter x:Key="HasValue" />
      <conv:BoolToTextConverter x:Key="BoolText" />
      <conv:BoolToImageConverter x:Key="BoolImage" />
      <conv:LocalizedFormatConverter x:Key="LocFormat" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
