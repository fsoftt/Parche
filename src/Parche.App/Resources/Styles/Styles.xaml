<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:Parche.App.Controls">

  <Style TargetType="Page" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
    <Setter Property="Shell.NavBarIsVisible" Value="False" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="{OnIdiom Default=14, TV=18}" />
  </Style>

  <Style x:Key="Display" TargetType="Label">
    <Setter Property="FontSize" Value="{OnIdiom Default=30, TV=44}" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="LineHeight" Value="0.95" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="Label">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="{OnIdiom Default=17, TV=22}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="Margin" Value="{OnIdiom Default='16,18,16,8', TV='48,22,48,10'}" />
  </Style>

  <Style x:Key="Muted" TargetType="Label">
    <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="{OnIdiom Default=13, TV=17}" />
  </Style>

  <Style x:Key="Brand" TargetType="Label">
    <Setter Property="Text" Value="PARCHE" />
    <Setter Property="FontSize" Value="{OnIdiom Default=22, TV=28}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="CharacterSpacing" Value="3" />
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="TextColor" Value="{StaticResource Accent}" />
    <Setter Property="Shadow">
      <Shadow Brush="{StaticResource Accent}" Opacity="0.7" Radius="18" Offset="0,0" />
    </Setter>
  </Style>

  <!-- Botones: estado Focused visible para el control remoto. -->
  <Style x:Key="BaseButton" TargetType="Button">
    <Setter Property="FontFamily" Value="OpenSansSemibold" />
    <Setter Property="FontSize" Value="{OnIdiom Default=15, TV=18}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="{OnIdiom Default='22,0', TV='28,0'}" />
    <Setter Property="HeightRequest" Value="{OnIdiom Default=46, TV=52}" />
    <Setter Property="BorderWidth" Value="2" />
    <Setter Property="BorderColor" Value="Transparent" />
    <Setter Property="BackgroundColor" Value="{StaticResource Surface2}" />
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Property="BorderColor" Value="{StaticResource FocusRing}" />
              <Setter Property="Scale" Value="1.06" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Property="Scale" Value="0.97" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Property="Opacity" Value="0.4" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

  <!-- Pill con degradado de marca y brillo violeta (PrimaryPill de Wired). -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="TextColor" Value="White" />
    <Setter Property="ImageSource" Value="play.png" />
    <Setter Property="ContentLayout" Value="Left,8" />
    <Setter Property="Shadow">
      <Shadow Brush="{StaticResource Accent2}" Opacity="0.45" Radius="22" Offset="0,6" />
    </Setter>
  </Style>

  <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
    <Setter Property="BorderColor" Value="{StaticResource Stroke}" />
    <Setter Property="BorderWidth" Value="1" />
  </Style>

  <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="{OnIdiom Default=13, TV=16}" />
    <Setter Property="HeightRequest" Value="36" />
  </Style>

  <Style TargetType="controls:Chip" BasedOn="{StaticResource ChipButton}" />

  <Style TargetType="Entry">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource TextDim}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontFamily" Value="OpenSansRegular" />
    <Setter Property="FontSize" Value="{OnIdiom Default=16, TV=20}" />
  </Style>

  <Style TargetType="Editor">
    <Setter Property="TextColor" Value="{StaticResource Text}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource TextDim}" />
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style TargetType="ActivityIndicator">
    <Setter Property="Color" Value="{StaticResource Accent}" />
  </Style>

  <Style TargetType="RefreshView">
    <Setter Property="RefreshColor" Value="{StaticResource Accent}" />
    <Setter Property="BackgroundColor" Value="{StaticResource Bg}" />
  </Style>

  <!-- Tarjeta de póster: anillo blanco + zoom al enfocarla con el D-pad. -->
  <Style TargetType="controls:TvCard">
    <Setter Property="StrokeThickness" Value="{OnIdiom Default=0, TV=3}" />
    <Setter Property="Stroke" Value="Transparent" />
    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList>
        <VisualStateGroup x:Name="FocusStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="Focused">
            <VisualState.Setters>
              <Setter Property="Stroke" Value="{StaticResource FocusRing}" />
              <Setter Property="Shadow">
                <Shadow Brush="{StaticResource Accent}" Opacity="0.8" Radius="26" Offset="0,0" />
              </Setter>
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </Setter>
  </Style>

  <Style TargetType="Shell" ApplyToDerivedTypes="True">
    <Setter Property="Shell.BackgroundColor" Value="{StaticResource Bg}" />
    <Setter Property="Shell.ForegroundColor" Value="{StaticResource Text}" />
    <Setter Property="Shell.TitleColor" Value="{StaticResource Text}" />
    <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
    <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Text}" />
    <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Accent}" />
    <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextDim}" />
    <Setter Property="Shell.FlyoutBackgroundColor" Value="{StaticResource Bg}" />
  </Style>
</ResourceDictionary>
