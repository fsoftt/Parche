<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Parche.App.Localization"
             xmlns:vm="clr-namespace:Parche.App.ViewModels"
             xmlns:controls="clr-namespace:Parche.App.Controls"
             x:Class="Parche.App.Views.StreamPickerPage"
             x:DataType="vm:StreamPickerViewModel"
             Shell.TabBarIsVisible="False">
  <Grid RowDefinitions="Auto,Auto,*" Padding="{OnIdiom Default='16,36,16,0', TV='48,32,48,0'}" RowSpacing="12">

    <!-- Cabecera -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Button IsVisible="{Binding IsTv, Converter={StaticResource Not}}" ImageSource="back.png"
              Style="{StaticResource GlassButton}" CornerRadius="20" Padding="8" WidthRequest="40" HeightRequest="40"
              VerticalOptions="Start" Clicked="OnBack" />
      <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
        <Label Text="{l:Translate Streams_Title}" Style="{StaticResource Muted}" />
        <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" MaxLines="2" />
        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" IsVisible="{Binding Subtitle, Converter={StaticResource HasValue}}" />
      </VerticalStackLayout>
    </Grid>

    <!-- Filtro por idioma + mejor opción -->
    <VerticalStackLayout Grid.Row="1" Spacing="10" IsVisible="{Binding HasStreams}">
      <Button x:Name="BestButton" Text="{l:Translate Streams_PlayBest}" Style="{StaticResource PrimaryButton}"
              Command="{Binding PlayBestCommand}" HorizontalOptions="Start" />
      <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="8" Padding="0,4" BindableLayout.ItemsSource="{Binding Filters}">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:ChipOption">
              <controls:Chip Text="{Binding Label}" IsSelected="{Binding IsSelected}"
                             Command="{Binding SetFilterCommand, Source={RelativeSource AncestorType={x:Type vm:StreamPickerViewModel}}, x:DataType=vm:StreamPickerViewModel}"
                             CommandParameter="{Binding .}" />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
      </ScrollView>
    </VerticalStackLayout>

    <!-- Lista -->
    <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None">
      <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
      </CollectionView.ItemsLayout>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="vm:StreamRow">
          <controls:TvCard FocusScale="1.02" Padding="12" Margin="0,2" Background="{StaticResource Surface2Brush}"
                           Command="{Binding PlayCommand, Source={RelativeSource AncestorType={x:Type vm:StreamPickerViewModel}}, x:DataType=vm:StreamPickerViewModel}"
                           CommandParameter="{Binding .}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border BackgroundColor="{StaticResource Surface}" StrokeThickness="1" Stroke="{StaticResource Stroke}"
                      StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Start" MinimumWidthRequest="56">
                <Label Text="{Binding Quality}" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Highlight}" />
              </Border>
              <VerticalStackLayout Grid.Column="1" Spacing="3">
                <Label Text="{Binding Title}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Languages}" Style="{StaticResource Muted}"
                       IsVisible="{Binding Languages, Converter={StaticResource HasValue}}" />
                <Label Text="{Binding Details}" Style="{StaticResource Muted}" MaxLines="1" LineBreakMode="TailTruncation"
                       IsVisible="{Binding Details, Converter={StaticResource HasValue}}" />
                <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasAvailability}">
                  <Ellipse Fill="{Binding AvailabilityColor}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                  <Label Text="{Binding Availability}" FontSize="13" FontAttributes="Bold" TextColor="{Binding AvailabilityColor}"
                         VerticalOptions="Center" />
                </HorizontalStackLayout>
              </VerticalStackLayout>
              <Image Grid.Column="2" Source="play.png" WidthRequest="24" HeightRequest="24" Opacity="0.8" VerticalOptions="Center" />
            </Grid>
          </controls:TvCard>
        </DataTemplate>
      </CollectionView.ItemTemplate>

      <CollectionView.EmptyView>
        <VerticalStackLayout Padding="0,16" Spacing="12">
          <HorizontalStackLayout Spacing="12" IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
            <Label Text="{l:Translate Streams_Searching}" Style="{StaticResource Muted}" VerticalOptions="Center" />
          </HorizontalStackLayout>

          <VerticalStackLayout Spacing="10" IsVisible="{Binding HasError}">
            <Label Text="{l:Translate Streams_Error}" TextColor="{StaticResource Accent}" FontAttributes="Bold" />
            <Label Text="{Binding Error}" Style="{StaticResource Muted}" />
            <Label Text="{l:Translate Streams_Hint}" Style="{StaticResource Muted}" />
            <Button Text="{l:Translate Common_Retry}" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="10" IsVisible="{Binding NoAddons}">
            <Label Text="{l:Translate Streams_NoAddons}" FontAttributes="Bold" />
            <Label Text="{l:Translate Streams_NoAddonsHelp}" Style="{StaticResource Muted}" />
            <Button x:Name="SettingsButton" Text="{l:Translate Streams_GoToSettings}" Command="{Binding OpenSettingsCommand}" HorizontalOptions="Start" />
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEmpty}">
            <Label Text="{l:Translate Streams_Empty}" FontAttributes="Bold" />
            <Label Text="{l:Translate Streams_Hint}" Style="{StaticResource Muted}" />
            <Button Text="{l:Translate Common_Retry}" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
          </VerticalStackLayout>

          <Label Text="{l:Translate Streams_NoMatch}" Style="{StaticResource Muted}" IsVisible="{Binding NoMatch}" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
    </CollectionView>
  </Grid>
</ContentPage>
